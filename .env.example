# Backblaze B2 (required) — S3-compatible API
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
B2_REGION=us-west-004

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=005EXAMPLE_NOT_A_REAL_KEY_ID
# B2_APPLICATION_KEY=K000abcdefghijklmnopqrstuvwxyz0
# B2_BUCKET_NAME=my-drone-inspections
# B2_REGION=us-west-004

# Optional: the S3 endpoint is derived from B2_REGION
# (https://s3.<region>.backblazeb2.com). Set this only to override that, e.g.
# for a custom or non-standard endpoint.
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# Optional: public base URL for a *public* bucket, used to build browser-facing
# object URLs. The app works without it (it falls back to presigned URLs).
# B2_PUBLIC_URL_BASE=https://my-drone-inspections.s3.us-west-004.backblazeb2.com

# Detection (local Ultralytics YOLO — no API key, weights auto-download once)
YOLO_MODEL=yolo11n.pt          # yolo11n | yolo11s | yolo11m; nano is the fast default
YOLO_DEVICE=auto               # auto -> CUDA, else CPU (mps is opt-in; see docs)
YOLO_CONF_THRESHOLD=0.25       # drop detections below this confidence
FRAME_SAMPLE_FPS=1.0           # frames sampled per second of video
MAX_FRAMES=300                 # hard cap on frames processed per video
# EXIFTOOL_PATH=/opt/homebrew/bin/exiftool   # optional: embedded-GPS extraction fallback

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
